# ============================================================
# SPACE LAIR - Plantilla de configuración (.env.example)
# ============================================================
# Copia este archivo a `.env` y ajusta según tu entorno.
# Cada valor replica EXACTAMENTE el default que el código usaba hardcodeado /
# os.environ.get(...). Todos los valores aquí son seguros (sin secretos reales);
# si llegas a añadir credenciales (p. ej. ANTHROPIC_API_KEY), NO las pongas en
# `.env.example`, solo en tu `.env` local (que está en .gitignore).

# --- Proveedor LLM (Ollama local por defecto) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Legacy (compatibilidad): OLLAMA_URL=.../api/generate
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen-agent:latest
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# Modelo router por defecto (igual en chapter_writer, editor, translator,
# image_planner, fact_checker, book_planner, text_summarizer, research)
ROUTER_MODEL=qwen-agent:latest

# --- Proveedor opcional Anthropic (solo si LLM_PROVIDER=anthropic) ---
ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# --- Research / SearXNG ---
SEARXNG_URL=http://localhost:8081
SEARXNG_BASE_URL=http://localhost:8081
SEARXNG_MAX_RETRIES=3
SEARXNG_BACKOFF_BASE=1.0
RESEARCH_USE_LLM=1
RESEARCH_ARCHIVE_ENABLED=0
RESEARCH_RELEVANCE_MIN_OVERLAP=0.15
PLANNER_TRANSLATE_TIMEOUT=60

# --- Chapter writer ---
CHAP_USE_LLM=1
CHAP_FORCE_MIN=0

# --- Fact checker ---
FACT_CHECK_CONSISTENCY_TIMEOUT=20
FACT_CHECK_CONSISTENCY_TOTAL_BUDGET=120

# --- Image search (Fases 1-3) ---
IMAGE_SEARCH_TIMEOUT=15
IMAGE_DOWNLOAD_TIMEOUT=20
IMAGE_SEARCH_MAX_PAGES=6
IMAGE_SEARCH_PER_PAGE=20
IMAGE_SEARCH_TOTAL_TIME_BUDGET=90
IMAGE_QUERY_MAX_WORDS=12
IMAGE_MIN_WIDTH=400
IMAGE_MIN_HEIGHT=300
IMAGE_MAX_ASPECT_RATIO=3.0

# --- Image generator ---
IMAGE_TOTAL_TIME_BUDGET=330.0
IMAGE_TIMEOUT=120
IMAGE_MAX_RETRIES=2
IMAGE_STEPS=20
IMAGE_STORAGE_ROOT=

# ============================================================
# FASE 4 (VLM) - ACTIVACIÓN PERMANENTE (decisión del arquitecto)
# ============================================================
VLM_VERIFICATION_ENABLED=1
VLM_TIMEOUT_SECONDS=40
VLM_MODEL_NAME=moondream-local

# --- UI / Auth ---
LOG_LEVEL=INFO
SPACE_LAIR_SECRET=change-me-in-production
SPACE_LAIR_TOKEN_EXPIRY=86400
