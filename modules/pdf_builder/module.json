{
  "id": "pdf_builder",
  "name": "PDF Builder",
  "description": "Genera un PDF profesional de un libro completo a partir de la estructura de libro, capítulos e imágenes.",
  "type": "agent",
  "capabilities": [
    "build_book_pdf"
  ],
  "requires_human_approval": false,
  "config": {
    "priority": 5,
    "timeout_seconds": 180,
    "page_size": "A4",
    "margins_mm": {
      "top": 25.4,
      "bottom": 25.4,
      "left": 25.4,
      "right": 25.4
    }
  }
}
